APP_HOST=0.0.0.0
APP_PORT=8002
PUBLIC_BASE_URL=http://127.0.0.1:8002

# 1 = placeholder translation (no GPU). 0 = real MADLAD-400 3B MT.
MT_MOCK=0

MT_MODEL_ID=google/madlad400-3b-mt
MT_DEVICE_MAP=cuda:0
MT_DTYPE=bfloat16

MT_DEFAULT_SOURCE_LANGUAGE=auto
MT_DEFAULT_TARGET_LANGUAGE=en

# Beam search (do_sample=0). 4 is the MADLAD paper default; 5 is a bit slower/better.
MT_DEFAULT_NUM_BEAMS=4
MT_DEFAULT_LENGTH_PENALTY=1.0
MT_DEFAULT_MAX_NEW_TOKENS=512
MT_DEFAULT_MAX_INPUT_TOKENS=480
MT_DEFAULT_BATCH_SIZE=4

MAX_TEXT_CHARS=20000
JOB_TTL_SECONDS=86400

# 1 = after each job, unload the GPU model (reload on next translate).
# Needed on the shared 12GB card. Set 0 only if MT owns the GPU.
MT_FREE_VRAM=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
