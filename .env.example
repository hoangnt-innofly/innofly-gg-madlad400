APP_HOST=0.0.0.0
APP_PORT=8002
PUBLIC_BASE_URL=http://127.0.0.1:8002

# Required on every /api/v1/* call as header: api-key: <this value>
SECRET_API_KEY=change-me

# 1 = placeholder translation (no GPU). 0 = real MADLAD-400 3B MT.
MT_MOCK=0

# Official checkpoint. Load with T5Tokenizer then model.to(cuda) — not device_map=auto
# (auto leaves T5 tied weights on the meta device → "Cannot copy out of meta tensor").
MT_MODEL_ID=google/madlad400-3b-mt
MT_DEVICE_MAP=cuda:0
MT_DTYPE=bfloat16

MT_DEFAULT_SOURCE_LANGUAGE=auto
MT_DEFAULT_TARGET_LANGUAGE=en

# Beam search width when a request sends no num_beams (default 4). Greedy (1)
# mistranslates short Japanese sentences noticeably more often (live ja->vi probes).
# The old name MT_DEFAULT_NUM_BEAMS is ignored.
MT_NUM_BEAMS=4
MT_DEFAULT_LENGTH_PENALTY=1.0
MT_DEFAULT_MAX_NEW_TOKENS=512
MT_DEFAULT_MAX_INPUT_TOKENS=480
MT_DEFAULT_BATCH_SIZE=4
# KV-cache cap per batched generate() call: rows * beams * (source + output) tokens.
MT_BATCH_MAX_TOKENS=4096

# Every line / sentence is its own model input. Spaced-script sentences (en, vi...) of a
# line are packed up to this many tokens (0 = never pack); CJK is never packed.
MT_SEGMENT_PACK_TOKENS=256
MT_SEGMENT_CLAUSE_TOKENS=96

# Lone words / short phrases: generate candidates + rerank with back-translation
# (fixes "kite" -> "đi đi", "kit" -> "đi", "cape" -> "cape"). See README.
MT_SHORT_TEXT_RERANK=1
MT_SHORT_TEXT_MAX_WORDS=3
MT_SHORT_TEXT_CANDIDATES=8
MT_SHORT_TEXT_BACKWARD_WEIGHT=1.0
MT_SHORT_TEXT_COPY_PENALTY=1.5
MT_SHORT_TEXT_REPEAT_PENALTY=2.0
# Max short units reranked per request (long word lists fall back to plain decoding).
MT_SHORT_TEXT_MAX_UNITS=50

# Fixed translations (JSON, re-read on change). Relative to the project root.
MT_GLOSSARY_PATH=data/glossary.json

MAX_TEXT_CHARS=20000
JOB_TTL_SECONDS=86400

# 1 = after each job, unload the GPU model (reload on next translate).
# Needed on the shared 12GB card. Set 0 only if MT owns the GPU.
MT_FREE_VRAM=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
